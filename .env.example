# Copy to .env at the repository root and fill in the key.

# Required. Free key from https://auth.abuse.ch/
URLHAUS_AUTH_KEY=

# Optional tuning. The values shown are the defaults.
# URLHAUS_TIMEOUT_SECONDS=15.0
# CACHE_TTL_SECONDS=900
# HEURISTIC_BENIGN_THRESHOLD=80

# Page-analysis stage (fetch the destination and score its markup).
# PAGE_STAGE_ENABLED=true
# Which page model scores pages. One switch for both the API and
# ai/markuplm/smoke_test_laya.ipynb, so the notebook always measures what the
# API serves. Absolute, ~, or relative to the repository root.
# Defaults to ai/markuplm/artifacts/laya_v3
# PAGE_MODEL_DIR=ai/markuplm/artifacts/laya_v3
# PAGE_FETCH_CONCURRENCY=2
# PAGE_FETCH_TIMEOUT_SECONDS=20.0
# PAGE_FETCH_BUDGET_SECONDS=45.0
# Route page fetches through a proxy, e.g. http://127.0.0.1:8080
# PAGE_FETCH_PROXY=

# Domain registration via RDAP (best-effort; unavailable records do not affect risk).
# RDAP_ENABLED=true
# RDAP_TIMEOUT_SECONDS=8
# PAGE_PREVIEW_ENABLED=true

# Explain is called only when a user clicks the button.
# Google Gemini, using the OpenAI-compatible endpoint:
EXPLANATION_API_KEY=
# A configured GEMINI_API_KEY is also accepted for Google's endpoint only.
# EXPLANATION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# EXPLANATION_MODEL=gemini-3.5-flash-lite
# EXPLANATION_TIMEOUT_SECONDS=35
# EXPLANATION_INCLUDE_SCREENSHOT=true
# For another provider, set its base URL, API key and vision-capable model.

# SQL history and evidence (apply backend/scripts/migrate_scan_evidence.py).
# DB_ENABLED=true
# DB_HOST=
# DB_PORT=1433
# DB_NAME=PhisangDB
# DB_USER=
# DB_PASSWORD=
