  "feature_schema": [
    {
      "name": "url",
      "type": "string",
      "description": "Normalized HTTP(S) URL; user credentials are removed"
    },
    {
      "name": "url_length",
      "type": "integer",
      "description": "Number of characters in the normalized URL"
    },
    {
      "name": "hostname_length",
      "type": "integer",
      "description": "Number of characters in the ASCII hostname"
    },
    {
      "name": "path_length",
      "type": "integer",
      "description": "Number of characters in the URL path"
    },
    {
      "name": "query_length",
      "type": "integer",
      "description": "Number of characters in the query string"
    },
    {
      "name": "fragment_length",
      "type": "integer",
      "description": "Number of characters in the fragment"
    },
    {
      "name": "path_depth",
      "type": "integer",
      "description": "Count of non-empty path segments"
    },
    {
      "name": "host_label_count",
      "type": "integer",
      "description": "Count of hostname labels; zero for IP hosts"
    },
    {
      "name": "host_dot_count",
      "type": "integer",
      "description": "Count of dots in the hostname"
    },
    {
      "name": "host_hyphen_count",
      "type": "integer",
      "description": "Count of hyphens in the hostname"
    },
    {
      "name": "max_host_label_length",
      "type": "integer",
      "description": "Length of the longest hostname label"
    },
    {
      "name": "tld_length",
      "type": "integer",
      "description": "Length of the final hostname label"
    },
    {
      "name": "is_ip",
      "type": "binary",
      "description": "One when the hostname is an IPv4 or IPv6 literal"
    },
    {
      "name": "has_userinfo",
      "type": "binary",
      "description": "One when credentials/userinfo existed before cleaning"
    },
    {
      "name": "has_punycode",
      "type": "binary",
      "description": "One when an ASCII hostname label begins with xn--"
    },
    {
      "name": "has_non_ascii",
      "type": "binary",
      "description": "One when the original URL contained non-ASCII text"
    },
    {
      "name": "letter_count",
      "type": "integer",
      "description": "Alphabetic character count"
    },
    {
      "name": "letter_ratio",
      "type": "float",
      "description": "Alphabetic character count divided by URL length"
    },
    {
      "name": "digit_count",
      "type": "integer",
      "description": "Numeric character count"
    },
    {
      "name": "digit_ratio",
      "type": "float",
      "description": "Numeric character count divided by URL length"
    },
    {
      "name": "special_count",
      "type": "integer",
      "description": "Non-alphanumeric character count"
    },
    {
      "name": "special_ratio",
      "type": "float",
      "description": "Non-alphanumeric character count divided by URL length"
    },
    {
      "name": "dot_count",
      "type": "integer",
      "description": "Dot count in the full URL"
    },
    {
      "name": "hyphen_count",
      "type": "integer",
      "description": "Hyphen count in the full URL"
    },
    {
      "name": "underscore_count",
      "type": "integer",
      "description": "Underscore count in the full URL"
    },
    {
      "name": "slash_count",
      "type": "integer",
      "description": "Slash count in the full URL"
    },
    {
      "name": "at_count",
      "type": "integer",
      "description": "At-sign count in the original URL"
    },
    {
      "name": "percent_count",
      "type": "integer",
      "description": "Percent-sign count in the full URL"
    },
    {
      "name": "percent_encoded_count",
