{
  "manifest_version": 3,
  "name": "Phisang",
  "version": "0.3.0",
  "description": "Check links for known threats and phishing, with website previews, domain details, and explanations of scan findings.",
  "action": {
    "default_title": "Phisang",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "webNavigation",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://phisang.kennethsunjaya.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://phisang.kennethsunjaya.com/*",
        "http://phisang.kennethsunjaya.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
